# Copia este archivo a .env y ajusta los valores. Nunca subas .env a Git.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Firma de los JWT (mínimo 32 caracteres). Valor de DESARROLLO: en producción usa uno propio y secreto.
JWT_SECRET=secreto-de-desarrollo-cambialo-en-produccion-0123456789
# Duración del access token en segundos (15 minutos)
JWT_ACCESS_TTL_SECONDS=900

# Usuario ADMIN que crea `npm run seed`
SEED_ADMIN_EMAIL=admin@logistica.local
SEED_ADMIN_PASSWORD=Admin-dev-2026!
SEED_ADMIN_NAME=Administrador
# Usuarios de demo (uno por rol; el jefe y el operario quedan en la bodega de ejemplo BOD-A).
# Son opcionales: el seed los crea solo si defines su correo y su contraseña. En producción usa
# contraseñas propias (el seed rechaza estas cuando NODE_ENV=production).
SEED_MANAGER_EMAIL=jefe@logistica.local
SEED_MANAGER_PASSWORD=Jefe-dev-2026!
SEED_OPERATOR_EMAIL=operario@logistica.local
SEED_OPERATOR_PASSWORD=Operario-dev-2026!
SEED_AUDITOR_EMAIL=auditor@logistica.local
SEED_AUDITOR_PASSWORD=Auditor-dev-2026!

# PostgreSQL local (crear con: psql -U postgres -h localhost -f scripts/setup-db.sql)
DATABASE_URL=postgresql://logistica:logistica_dev@localhost:5432/logistica_dev
TEST_DATABASE_URL=postgresql://logistica:logistica_dev@localhost:5432/logistica_test

# Refresh token: duración en segundos (7 días). La cookie lleva Secure por defecto solo en producción.
REFRESH_TTL_SECONDS=604800
# COOKIE_SECURE=false
# Rate limiting por IP (general sobre /api y estricto en login y refresh)
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_AUTH_WINDOW_SECONDS=900

# Despliegue (opcionales en local)
# Saltos de proxy de confianza: 0 en local, 1 en Render (para que el límite de peticiones vea la IP real)
TRUST_PROXY=0
# Carpeta con el build del frontend que sirve el backend (si no tiene index.html, no se sirve nada)
PUBLIC_DIR=public
